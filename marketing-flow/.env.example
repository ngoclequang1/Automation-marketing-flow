# Backend
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
GOOGLE_SPREADSHEET_ID=
DROPBOX_ACCESS_TOKEN=
DROPBOX_UPLOAD_PATH=/MarketingAppUploads
MFA_API_KEY=replace-with-a-long-random-value
MEDIA_ROOT=media
